<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =====================================================================
         === HUMAN ===
         The printable payroll timecard slip: lodge header, a shift table per
         employee, totals, and the digital approval signatures.
         === AI AGENT ===
         Two ir.actions.report (html preview + pdf) plus the QWeb template, all on
         elks.timecard.report.wizard. It re-queries the wizard data and looks up the
         matching elks.timecard to print signatures. Kept ASCII-only (HTML entities)
         so wkhtmltopdf does not mojibake.
         ===================================================================== -->

    <record id="action_report_timecard" model="ir.actions.report">
        <field name="name">Employee Timecard</field>
        <field name="model">elks.timecard.report.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">elksattendance.report_employee_timecard</field>
        <field name="report_file">elksattendance.report_employee_timecard</field>
    </record>

    <!-- Companion PDF report for download -->
    <record id="action_report_timecard_pdf" model="ir.actions.report">
        <field name="name">Employee Timecard (PDF)</field>
        <field name="model">elks.timecard.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">elksattendance.report_employee_timecard</field>
        <field name="report_file">elksattendance.report_employee_timecard</field>
    </record>

    <template id="report_employee_timecard">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-set="grouped" t-value="wizard._get_attendance_data()"/>
                <t t-set="events_by_emp" t-value="wizard._get_event_1099_data()"/>
                <t t-set="sorted_employees" t-value="wizard._get_report_employees()"/>
                <t t-set="settings"
                   t-value="wizard.env['elks.lodge.settings'].sudo().search([], limit=1)"/>

                <t t-foreach="sorted_employees" t-as="employee">
                        <!-- Force each employee's timecard onto its own sheet for
                             payroll. page-break-BEFORE on every card after the
                             first avoids a trailing blank page. -->
                        <div class="page"
                             t-attf-style="font-size: 12px; #{'' if employee_first else 'page-break-before: always;'}">
                            <!-- ===== LODGE HEADER WITH LOGOS ===== -->
                            <table style="width: 100%; margin-bottom: 10px; border: none;">
                                <tr>
                                    <td style="width: 15%; text-align: center; vertical-align: middle; border: none; padding: 0;">
                                        <t t-if="settings and settings.logo_primary">
                                            <img t-att-src="image_data_uri(settings.logo_primary)"
                                                 style="max-height: 80px; max-width: 100px;"
                                                 alt="Elks USA"/>
                                        </t>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle; border: none; padding: 0 10px;">
                                        <h2 style="font-size: 22px; margin: 0 0 2px 0; color: #333;">
                                            <t t-if="settings and settings.name">
                                                <span t-field="settings.name"/>
                                            </t>
                                            <t t-else="">Elks Lodge</t>
                                            <t t-if="settings and settings.lodge_number">
                                                #<span t-field="settings.lodge_number"/>
                                            </t>
                                        </h2>
                                        <p style="color: #777; font-size: 11px; margin: 0;">
                                            Benevolent and Protective Order of Elks
                                        </p>
                                        <h3 style="font-size: 18px; margin: 6px 0 0 0; color: #003366;">
                                            Employee Timecard
                                        </h3>
                                    </td>
                                    <td style="width: 15%; text-align: center; vertical-align: middle; border: none; padding: 0;">
                                        <t t-if="settings and settings.logo_lodge">
                                            <img t-att-src="image_data_uri(settings.logo_lodge)"
                                                 style="max-height: 80px; max-width: 100px;"
                                                 alt="Lodge Logo"/>
                                        </t>
                                    </td>
                                </tr>
                            </table>
                            <div style="border-top: 2px solid #003366; margin-bottom: 15px;"/>

                            <!-- Employee info and period -->
                            <div style="margin-bottom:20px;">
                                <table style="width:100%;">
                                    <tr>
                                        <td style="width:60%;">
                                            <h3 style="margin:0; color:#333;">
                                                <span t-esc="employee.name"/>
                                            </h3>
                                            <p style="margin:4px 0 0 0; font-size:12px; color:#777;"
                                               t-if="employee.department_id">
                                                Department: <span t-esc="employee.department_id.name"/>
                                            </p>
                                        </td>
                                        <td style="width:40%; text-align:right; vertical-align:top;">
                                            <p style="margin:0; font-size:12px; color:#555;">
                                                <strong>Period:</strong>
                                                <span t-field="wizard.date_from"
                                                      t-options='{"format": "MM/dd/yyyy"}'/>
                                                to
                                                <span t-field="wizard.date_to"
                                                      t-options='{"format": "MM/dd/yyyy"}'/>
                                            </p>
                                            <p style="margin:4px 0 0 0; font-size:11px; color:#888;">
                                                Printed: <span t-esc="time.strftime('%m/%d/%Y')"/>
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Attendance table -->
                            <!-- .get: an event-only worker (1099 pay, no clocked
                                 hours) has no attendance recordset in grouped. -->
                            <t t-set="att_recs" t-value="grouped.get(employee) or wizard.env['hr.attendance']"/>
                            <!-- Event shifts are paid at the call-out (event) rate
                                 INSTEAD of the normal wage, so pull them out of the
                                 regular-hours table and price them in the Event Pay
                                 section below. rate>0 means a certified department
                                 call-out matched this shift for this person (any
                                 pay category). -->
                            <t t-set="elks_ev_atts" t-value="att_recs.filtered(lambda a: a._elks_effective_event_rate()[0] &gt; 0)"/>
                            <t t-set="records" t-value="(att_recs - elks_ev_atts).sorted(key=lambda a: a.check_in)"/>
                            <t t-set="total_hours" t-value="0"/>
                            <t t-set="is_tipped" t-value="employee.x_receives_tips"/>
                            <!-- Event gratuity (elksevent) rides on the timecard even
                                 for staff who are not normally tipped. -->
                            <t t-set="has_grat"
                               t-value="('x_gratuity_share' in records._fields) and any(records.mapped('x_gratuity_share'))"/>
                            <t t-set="has_coord"
                               t-value="('x_coordinator_fee_share' in records._fields) and any(records.mapped('x_coordinator_fee_share'))"/>
                            <t t-set="show_tips" t-value="is_tipped or has_grat or has_coord"/>
                            <t t-set="total_tips" t-value="0"/>

                            <table style="width:100%; border-collapse:collapse; font-size:12px;">
                                <thead>
                                    <tr style="background:#e8e8e8;">
                                        <th style="padding:6px 8px; border:1px solid #ccc; text-align:left; width:20%;">Date</th>
                                        <th style="padding:6px 8px; border:1px solid #ccc; text-align:left; width:12%;">Day</th>
                                        <th style="padding:6px 8px; border:1px solid #ccc; text-align:center; width:18%;">Check In</th>
                                        <th style="padding:6px 8px; border:1px solid #ccc; text-align:center; width:18%;">Check Out</th>
                                        <th style="padding:6px 8px; border:1px solid #ccc; text-align:right; width:14%;">Hours</th>
                                        <t t-if="show_tips">
                                            <th style="padding:6px 8px; border:1px solid #ccc; text-align:right; width:10%;">Tips</th>
                                        </t>
                                        <th style="padding:6px 8px; border:1px solid #ccc; text-align:right; width:14%;">Running Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="records" t-as="att">
                                        <t t-set="hours" t-value="att.worked_hours or 0.0"/>
                                        <t t-set="total_hours" t-value="total_hours + hours"/>
                                        <!-- Personal tip uses the approver's per-shift
                                             source (x_tip_payable = entered or Clover). -->
                                        <t t-set="row_tip"
                                           t-value="(att.x_tip_payable or 0.0 if is_tipped else 0.0) + (att.x_gratuity_share or 0.0 if 'x_gratuity_share' in att._fields else 0.0) + (att.x_coordinator_fee_share or 0.0 if 'x_coordinator_fee_share' in att._fields else 0.0)"/>
                                        <t t-if="show_tips">
                                            <t t-set="total_tips" t-value="total_tips + row_tip"/>
                                        </t>
                                        <tr>
                                            <td style="padding:5px 8px; border:1px solid #ddd;">
                                                <span t-esc="wizard._format_date(att.check_in)"/>
                                            </td>
                                            <td style="padding:5px 8px; border:1px solid #ddd;">
                                                <span t-esc="att.check_in.strftime('%a') if att.check_in else ''"/>
                                            </td>
                                            <td style="padding:5px 8px; border:1px solid #ddd; text-align:center;">
                                                <span t-esc="wizard._format_time(att.check_in)"/>
                                            </td>
                                            <td style="padding:5px 8px; border:1px solid #ddd; text-align:center;">
                                                <t t-if="att.check_out">
                                                    <span t-esc="wizard._format_time(att.check_out)"/>
                                                </t>
                                                <t t-else="">
                                                    <span style="color:red; font-style:italic;">OPEN</span>
                                                </t>
                                            </td>
                                            <td style="padding:5px 8px; border:1px solid #ddd; text-align:right;">
                                                <span t-esc="wizard._format_hours(hours)"/>
                                            </td>
                                            <t t-if="show_tips">
                                                <td style="padding:5px 8px; border:1px solid #ddd; text-align:right;">
                                                    <span t-esc="'$%.2f' % row_tip"/>
                                                </td>
                                            </t>
                                            <td style="padding:5px 8px; border:1px solid #ddd; text-align:right; color:#666;">
                                                <span t-esc="wizard._format_hours(total_hours)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr style="background:#f0f0f0; font-weight:bold;">
                                        <td t-att-colspan="4" style="padding:6px 8px; border:1px solid #ccc; text-align:right;">
                                            Period Total:
                                        </td>
                                        <td style="padding:6px 8px; border:1px solid #ccc; text-align:right;">
                                            <span t-esc="wizard._format_hours(total_hours)"/>
                                        </td>
                                        <t t-if="show_tips">
                                            <td style="padding:6px 8px; border:1px solid #ccc; text-align:right;">
                                                <span t-esc="'$%.2f' % total_tips"/>
                                            </td>
                                        </t>
                                        <td style="padding:6px 8px; border:1px solid #ccc; text-align:right;">
                                            <span t-esc="wizard._format_hours(total_hours)"/>
                                            <span style="font-size:10px; color:#666;">
                                                (<span t-esc="'%.2f' % total_hours"/> decimal)
                                            </span>
                                        </td>
                                    </tr>
                                    <tr style="font-size:11px; color:#888;">
                                        <td colspan="4" style="padding:4px 8px; text-align:right;">
                                            Total entries:
                                        </td>
                                        <td t-att-colspan="'3' if show_tips else '2'" style="padding:4px 8px; text-align:right;">
                                            <span t-esc="len(records)"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>

                            <!-- ===== TIPS SUMMARY (payable; Clover replaces entered) ===== -->
                            <t t-set="tc"
                               t-value="wizard.env['elks.timecard'].sudo().search([('employee_id', '=', employee.id), ('period_start', '=', wizard.date_from), ('period_end', '=', wizard.date_to)], limit=1)"/>
                            <!-- Tips summary. The Clover-collected number is NOT shown
                                 here — this report is also emailed to the employee, and
                                 employees don't see the Clover sync figure. The payable
                                 already reflects the approver's per-shift source choice. -->
                            <!-- (Tips summary line removed per user request — the
                                 per-shift Tips column and Period Total above
                                 already show the approved tips.) -->
                            <t t-set="tc"
                               t-value="wizard.env['elks.timecard'].sudo().search([('employee_id', '=', employee.id), ('period_start', '=', wizard.date_from), ('period_end', '=', wizard.date_to)], limit=1)"/>

                            <!-- ===== EVENT PAY (call-out rate) — second area =====
                                 Clocked shifts matched to a certified department call-out
                                 are paid at the EVENT RATE instead of the normal wage, for
                                 ANY worker (these shifts were pulled out of the regular
                                 hours above). A 1099 who was rostered but never clocked in
                                 falls back to the planned roster line. -->
                            <t t-set="is_1099"
                               t-value="('x_pay_category' in employee._fields) and employee.x_pay_category == '1099'"/>
                            <t t-set="ev_lines"
                               t-value="events_by_emp.get(employee) if (is_1099 and not elks_ev_atts) else None"/>
                            <t t-if="elks_ev_atts or ev_lines">
                                <div style="margin-top:25px;">
                                    <div style="background:#003366; color:#fff; padding:5px 8px; font-weight:bold; font-size:12px;">
                                        <t t-if="is_1099">1099 Event Pay — </t><t t-else="">Event Pay (call-out rate) — </t><span t-esc="employee.name"/>
                                    </div>
                                    <table style="width:100%; border-collapse:collapse; font-size:11px; margin-top:4px;">
                                        <thead>
                                            <tr style="background:#f0f0f0;">
                                                <th style="padding:5px 8px; border:1px solid #ccc; text-align:left;">Date</th>
                                                <th style="padding:5px 8px; border:1px solid #ccc; text-align:left;">Day</th>
                                                <th style="padding:5px 8px; border:1px solid #ccc; text-align:center;">Check In</th>
                                                <th style="padding:5px 8px; border:1px solid #ccc; text-align:center;">Check Out</th>
                                                <th style="padding:5px 8px; border:1px solid #ccc; text-align:left;">Event</th>
                                                <th style="padding:5px 8px; border:1px solid #ccc; text-align:right;">Hours</th>
                                                <th style="padding:5px 8px; border:1px solid #ccc; text-align:right;">Event Rate/hr</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="ev_hours" t-value="0.0"/>
                                            <t t-if="elks_ev_atts">
                                                <!-- Clocked event shifts: same Date/Day/Check In/Check Out
                                                     as the regular rows, showing the event rate. Payroll
                                                     computes the actual pay from hours x rate. -->
                                                <t t-foreach="elks_ev_atts" t-as="att">
                                                    <t t-set="er" t-value="att._elks_effective_event_rate()"/>
                                                    <t t-set="ev_hours" t-value="ev_hours + (att.worked_hours or 0.0)"/>
                                                    <tr>
                                                        <td style="padding:5px 8px; border:1px solid #ccc;"><span t-esc="wizard._format_date(att.check_in)"/></td>
                                                        <td style="padding:5px 8px; border:1px solid #ccc;"><span t-esc="att.check_in.strftime('%a') if att.check_in else ''"/></td>
                                                        <td style="padding:5px 8px; border:1px solid #ccc; text-align:center;"><span t-esc="wizard._format_time(att.check_in)"/></td>
                                                        <td style="padding:5px 8px; border:1px solid #ccc; text-align:center;">
                                                            <t t-if="att.check_out"><span t-esc="wizard._format_time(att.check_out)"/></t>
                                                            <t t-else=""><span style="color:red; font-style:italic;">OPEN</span></t>
                                                        </td>
                                                        <td style="padding:5px 8px; border:1px solid #ccc;"><span t-esc="att.x_event_id.name or ''"/></td>
                                                        <td style="padding:5px 8px; border:1px solid #ccc; text-align:right;"><span t-esc="wizard._format_hours(att.worked_hours or 0.0)"/></td>
                                                        <td style="padding:5px 8px; border:1px solid #ccc; text-align:right;"><span t-esc="'$%.2f' % er[0]"/></td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <!-- No clock-in (1099 only): planned certified roster times. -->
                                                <t t-foreach="ev_lines" t-as="el">
                                                    <t t-set="ev_hours" t-value="ev_hours + (el.hours or 0.0)"/>
                                                    <tr>
                                                        <td style="padding:5px 8px; border:1px solid #ccc;"><span t-esc="el.callout_id.event_date and el.callout_id.event_date.strftime('%m/%d/%Y') or ''"/></td>
                                                        <td style="padding:5px 8px; border:1px solid #ccc;"><span t-esc="el.callout_id.event_date.strftime('%a') if el.callout_id.event_date else ''"/></td>
                                                        <td style="padding:5px 8px; border:1px solid #ccc; text-align:center;"><span t-esc="el.start_str or '—'"/></td>
                                                        <td style="padding:5px 8px; border:1px solid #ccc; text-align:center;"><span t-esc="el.end_str or '—'"/></td>
                                                        <td style="padding:5px 8px; border:1px solid #ccc;"><span t-esc="el.callout_id.event_name or ''"/></td>
                                                        <td style="padding:5px 8px; border:1px solid #ccc; text-align:right;"><span t-esc="wizard._format_hours(el.hours or 0.0)"/></td>
                                                        <td style="padding:5px 8px; border:1px solid #ccc; text-align:right;"><span t-esc="'$%.2f' % (el.rate or 0.0)"/></td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </tbody>
                                        <tfoot>
                                            <tr style="background:#f0f0f0; font-weight:bold;">
                                                <td colspan="5" style="padding:6px 8px; border:1px solid #ccc; text-align:right;">Total Event Hours:</td>
                                                <td style="padding:6px 8px; border:1px solid #ccc; text-align:right;"><span t-esc="wizard._format_hours(ev_hours)"/></td>
                                                <td style="padding:6px 8px; border:1px solid #ccc;"/>
                                            </tr>
                                        </tfoot>
                                    </table>
                                    <p style="font-size:10px; color:#666; margin-top:3px;">
                                        <t t-if="is_1099">1099 non-employee compensation — event hours at the call-out rate shown, paid without tax withholding.</t>
                                        <t t-else="">Paid at the event (call-out) rate shown in place of the normal wage for these shifts; event hours are excluded from the regular hours above. Payroll calculates the pay.</t>
                                    </p>
                                </div>
                            </t>

                            <!--
                                Payment summary block removed per user request
                                — the timecard now shows only the approved
                                tips total (see "Payable Tips" row in the
                                summary table above). Hourly wages are
                                handled by payroll outside of this report.
                            -->

                            <!-- Digital approval / signature block -->
                            <t t-set="tc"
                               t-value="wizard.env['elks.timecard'].sudo().search([('employee_id', '=', employee.id), ('period_start', '=', wizard.date_from), ('period_end', '=', wizard.date_to)], limit=1)"/>
                            <div style="margin-top:40px;">
                                <table style="width:100%; font-size:11px;">
                                    <tr>
                                        <td style="width:50%; border-top:1px solid #333; padding-top:4px;">
                                            <strong>Employee Approval</strong><br/>
                                            <t t-if="tc and tc.employee_signed_name">
                                                <span style="color:#060; font-weight:bold;">Approved</span> by
                                                <span t-esc="tc.employee_signed_name"/><br/>
                                                <span t-esc="tc.employee_signed_date"
                                                      t-options='{"widget": "datetime", "format": "MM/dd/yyyy hh:mm a"}'/>
                                            </t>
                                            <t t-else="">
                                                <span style="color:#999;">Signature: ____________________</span>
                                            </t>
                                        </td>
                                        <td style="width:10%;"/>
                                        <td style="width:40%; border-top:1px solid #333; padding-top:4px;">
                                            <strong>Supervisor Approval</strong><br/>
                                            <t t-if="tc and tc.approver_signed_name">
                                                <span style="color:#060; font-weight:bold;">Approved</span> by
                                                <span t-esc="tc.approver_signed_name"/><br/>
                                                <span t-esc="tc.approver_signed_date"
                                                      t-options='{"widget": "datetime", "format": "MM/dd/yyyy hh:mm a"}'/>
                                            </t>
                                            <t t-else="">
                                                <span style="color:#999;">Signature / Date: ____________</span>
                                            </t>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
